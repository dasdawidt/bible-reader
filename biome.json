{
    "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
    "root": true,
    "files": {
        "ignoreUnknown": true
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "defaultBranch": "main"
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "operatorLinebreak": "before",
            "quoteStyle": "single"
        }
    },
    "html": {
        "experimentalFullSupportEnabled": true,
        "formatter": {
            "enabled": true
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "rules": {
            "style": {
                "useVueHyphenatedAttributes": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": ["src/assets/translations/**"],
            "files": {
                "maxSize": 26214400
            }
        }
    ]
}
